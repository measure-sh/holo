graph TD
    START([Start]) --> INIT["Init device + auto-select package"]
    INIT --> DATA["Start pollers"]
    DATA --> LOOP

    subgraph LOOP["Event Loop"]
        POLL["Poll channels"] --> DRAW["Render"] --> WAIT["Wait key (1s)"]
        WAIT -->|key| DISPATCH["Dispatch action"] --> POLL
        WAIT -->|timeout| POLL
    end

    subgraph BG["Pollers → mpsc → Poll"]
        direction LR
        BAT["Battery 30s"]
        PID["PID 1s"]
        MON["Monitor 1s"]
        CONN["Connectivity 5s"]
        LOG["Logcat stream"]
    end

    BG --> POLL
    DISPATCH -->|spawn| OPS["One-off threads\n(adb actions, queries, pulls)"]
    OPS -->|mpsc| POLL
    PID -.->|PID change| LOG
    DISPATCH -.->|AtomicU8| MON

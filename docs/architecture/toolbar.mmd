graph TD
    F1["F1: Devices"] -->|thread| LIST_D["adb devices + list-avds"]
    LIST_D --> DROP_D["Dropdown + fuzzy filter"]
    DROP_D --> SEL{Select}
    SEL -->|device| CHANGE["ChangeDevice → reset state"]
    SEL -->|offline AVD| LAUNCH["Launch emulator → poll boot 1s×60"] --> CHANGE

    F2["F2: Apps"] -->|thread| LIST_P["pm list packages -3"]
    LIST_P --> DROP_P["Dropdown + fuzzy filter"]
    DROP_P --> APP["ChangeApp"]

    CHANGE -->|auto-select pkg| APP
    APP --> BUILD["Start pollers + fetch initial state"]

    APP -.->|save| CACHE["~/.cache/msh/last_package"]
    CHANGE -.->|load| CACHE

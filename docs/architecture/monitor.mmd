graph TD
    VIS["Visibility mask (AtomicU8)"] --> CHK{mask == 0?}
    CHK -->|yes| SLEEP["Sleep, skip"]
    CHK -->|no| SCOPE["Parallel spawn per tick"]

    SCOPE -->|SYSTEM bit| MEM["meminfo + cpu"]
    SCOPE -->|FRAMES bit| GFX["gfxinfo"]
    SCOPE -->|"DISK bit + tick%5"| DISK["du -s"]

    MEM --> SAMPLE["MonitorSample"]
    GFX --> SAMPLE
    DISK --> SAMPLE

    SAMPLE --> HIST["History (60 samples)"]
    HIST --> P4["Frames panel: frame deltas, slow/frozen %"]
    HIST --> P5["Disk panel: data + cache size, trends"]
    HIST --> P6["System panel: CPU %, RSS memory"]

graph TD
    START([Start]) --> DETECT["Detect device via adb devices"]
    DETECT --> HAS{Device?}
    HAS -->|no| WAIT_F1["Show empty UI, wait for F1"]
    HAS -->|yes| CACHE["Load cached package from ~/.cache/msh"]
    WAIT_F1 -->|F1 → select device| CACHE

    CACHE --> MATCH{Cached pkg on device?}
    MATCH -->|yes| CONNECT
    MATCH -->|no| WAIT_F2["Open app selector"]
    WAIT_F2 -->|F2 → select package| CONNECT

    CONNECT["Connect to device + package"] --> START_POLLERS

    subgraph START_POLLERS["Start Background Threads"]
        direction LR
        P1["pidof 1s"]
        P2["battery 30s"]
        P3["connectivity 5s"]
        P4["monitor 1s\n(mem, cpu, gfx, disk)"]
    end

    START_POLLERS --> PID_READY{PID found?}
    PID_READY -->|yes| LOGCAT["Start logcat --pid=PID"]
    PID_READY -->|no| POLL_PID["Keep polling pidof"]
    POLL_PID --> PID_READY

    LOGCAT --> RUNNING["App Running"]

    subgraph RUNNING["Main Loop"]
        direction TB
        RECV["Receive poller data"] --> RENDER["Render all visible panels"]
        RENDER --> KEY["Wait for input (1s timeout)"]
        KEY -->|timeout| RECV
        KEY -->|panel key| FOCUS["Focus/zoom/toggle panel"]
        KEY -->|action key| ACTION["Execute adb command"]
        KEY -->|F1/F2| SWITCH["Switch device or app → reconnect"]
        FOCUS --> RECV
        ACTION --> RECV
    end

    SWITCH --> CONNECT

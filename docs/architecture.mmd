graph TD
    %% ── Startup ──
    START([Start])
    START --> DETECT["Detect device\nadb devices"]

    %% ── Device Selection ──
    DETECT --> HAS{Device?}
    HAS -->|no| WAIT_F1["Wait for F1"]
    HAS -->|yes| CACHE["Load cached package"]
    WAIT_F1 -->|select device| CACHE

    %% ── Package Selection ──
    CACHE --> MATCH{Package found?}
    MATCH -->|yes| CONNECT
    MATCH -->|no| WAIT_F2["Wait for F2"]
    WAIT_F2 -->|select package| CONNECT

    %% ── Connection ──
    CONNECT["Connect to device + package"]
    CONNECT --> POLLERS
    CONNECT --> FETCH["Fetch initial state\npermissions, databases,\nfiles, settings"]

    %% ── Background Threads ──
    subgraph POLLERS[" "]
        direction LR
        P1["🔄 pidof\n1s"]
        P2["🔋 battery\n30s"]
        P3["📡 connectivity\n5s"]
        P4["📊 monitor\n1s · gated"]
    end

    POLLERS --> PID{PID found?}
    PID -->|no| PID
    PID -->|yes| LOGCAT["Start logcat stream\nadb logcat --pid"]

    %% ── Main Loop ──
    LOGCAT --> LOOP
    FETCH --> LOOP

    subgraph LOOP["Main Loop"]
        direction TB

        RECV["Receive poller data"]
        RECV --> RENDER["Render visible panels"]
        RENDER --> KEY["Wait for input · 1s timeout"]

        KEY -->|timeout| RECV

        KEY -->|"0-8"| TOGGLE["Toggle panel visibility"]
        KEY -->|"c l t p f d"| FOCUS["Focus panel"]
        KEY -->|z| ZOOM["Zoom in/out"]
        KEY -->|"o k and others"| ACTION["Run adb command"]
        KEY -->|F1 · F2| SWITCH["Switch device/app"]

        TOGGLE --> RECV
        FOCUS --> RECV
        ZOOM --> RECV
        ACTION --> RECV
    end

    SWITCH --> CONNECT
